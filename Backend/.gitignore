# =========================================================
# SafeFlux — Backend .gitignore (scoped; the root file also applies)
# =========================================================

# Environment / secrets — only the .env.example template is committed
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/

# Test / coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local databases (SQLite MVP + isolated test database)
*.db
*.sqlite
*.sqlite3

# Runtime / logs
*.log
logs/
*.pid
*.pid.lock

# Generated exports written by local runs (reports, PDFs)
exports/
generated/
artifacts/

# Secrets and key material must never land here
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
