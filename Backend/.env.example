# SafeFlux backend — environment template
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Generate a JWT secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# development | staging | production
ENVIRONMENT=development
DEBUG=false

# SQLite for local MVP; use postgresql://... for production
DATABASE_URL=sqlite:///./safeflux.db

# Minimum 16 chars in development, 32 chars in production
JWT_SECRET=

# Frontend origin(s) allowed by CORS (comma-separated for several)
FRONTEND_URL=http://localhost:5173

# Baseline API rate limit (requests per window, per client)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- authentication sessions (Part 2) ---
# Session cookie / JWT lifetime in minutes (5..43200; default 1 day)
SESSION_TTL_MINUTES=1440

# Tighter per-IP budget for sensitive auth endpoints (signup/login)
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Reject request bodies larger than this (bytes; >=1024)
MAX_REQUEST_BODY_BYTES=65536

# --- deterministic simulator budgets (Part 4) ---
# Hard caps so a simulation request can never ask for unbounded integration.
# duration (seconds)
SIM_MAX_DURATION_S=3600
# smallest allowed time step (seconds)
SIM_MIN_TIME_STEP_S=0.05
# maximum sample points (duration / time_step + 1)
SIM_MAX_SAMPLES=20000
# per-IP budget for POST /simulations/run (expensive endpoint)
SIM_RATE_LIMIT_RUNS=30
SIM_RATE_LIMIT_WINDOW_SECONDS=60

# --- live simulated telemetry (Part 5) ---
# Retained frames per plant (bounded history)
TELEMETRY_MAX_HISTORY=600
# Maximum plants whose telemetry is kept in one process
TELEMETRY_MAX_PLANTS=200
# Concurrent SSE stream limits (total / per plant / per user)
TELEMETRY_MAX_STREAMS=64
TELEMETRY_MAX_STREAMS_PER_PLANT=8
TELEMETRY_MAX_STREAMS_PER_USER=4
# Wall-clock pacing between replayed frames (milliseconds)
TELEMETRY_REPLAY_INTERVAL_MS=250
# Default number of frames returned by the history endpoint
TELEMETRY_HISTORY_DEFAULT_LIMIT=120

# --- deterministic scenario search (Part 7) ---
# Hard ceilings for one search. A request may tighten these, never loosen them,
# and the engine clamps them to its own ceilings at startup.
# maximum scenarios (simulations) one search may run
SEARCH_MAX_SCENARIOS=150
# maximum combinations in a combination search
SEARCH_MAX_COMBINATIONS=36
# maximum boundary-refinement levels
SEARCH_MAX_REFINEMENT_DEPTH=6
# overall wall-clock timeout for one search (seconds, 1..900)
SEARCH_TIMEOUT_SECONDS=90
# per-IP budget for POST /searches/run (the most expensive endpoint)
SEARCH_RATE_LIMIT_RUNS=20
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60

# --- AI provider (Nebius Token Factory / NVIDIA Nemotron) ---
# Used starting in Part 8. Backend only. Never expose to the frontend.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=
