# =========================================================
# SafeFlux — root .env.example
# Deployment-facing template for the repository root.
#
# The application itself reads environment variables from the two
# service-level files — copy those, not this one:
#   Backend/.env.example    → Backend/.env     (API, database, auth, AI)
#   frontend/.env.example   → frontend/.env    (VITE_* only, public by design)
#
# Rule: every real `.env` is git-ignored; only `*.env.example` templates are
# committed, and they must never contain a real value.
# =========================================================

# --- root one-command runner (scripts/dev.mjs) ---
# Port the uvicorn API binds to when started with `npm run dev`.
# Deliberately namespaced so a generic host PORT cannot redirect the API.
SAFEFLUX_BACKEND_PORT=8000

# --- deployment checklist (Part 10) ---
# 1. ENVIRONMENT=production in Backend/.env  → forbids DEBUG, requires JWT_SECRET >= 32 chars
# 2. FRONTEND_URL must list the exact deployed frontend origin(s) (strict CORS allowlist)
# 3. DATABASE_URL points at the deployment database (SQLite is the local MVP only)
# 4. NEBIUS_API_KEY / NEBIUS_BASE_URL / NEBIUS_MODEL stay in Backend/.env only —
#    server-side, never in VITE_* vars, never in Git, never in the browser bundle
# 5. VITE_API_BASE_URL in frontend/.env must equal the deployed API origin + /api/v1
